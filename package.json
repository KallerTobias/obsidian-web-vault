{
  "name": "obsidian-web-vault",
  "version": "1.0.1-beta",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run --project node --project web",
    "test:perf": "vitest run --project perf",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web && tsc --noEmit -p e2e",
    "check:svelte": "node tools/svelte-check/run.mjs",
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch server/main.ts serve\" \"vite --config web/vite.config.ts\"",
    "build": "vite build --config web/vite.config.ts && esbuild server/main.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server.js",
    "e2e": "sh scripts/e2e.sh",
    "e2e:local": "npm run build && playwright test"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@playwright/test": "^1.64.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "@types/unist": "^3.0.3",
    "3d-force-graph": "^1.80.1",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "force-graph": "^1.52.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-string": "^3.0.1",
    "jsdom": "^30.1.3",
    "katex": "^0.19.0",
    "mdast-util-gfm-footnote": "^2.1.0",
    "mdast-util-gfm-strikethrough": "^2.0.1",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-gfm-task-list-item": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^12.2.0",
    "micromark-extension-gfm-footnote": "^2.1.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.2",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "svelte": "^5.57.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "vite": "^6.4.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "@simplewebauthn/server": "^13.3.3",
    "chokidar": "^4.0.3",
    "dayjs": "^1.11.23",
    "fastify": "^5.12.7",
    "minisearch": "^7.2.0",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1"
  }
}
